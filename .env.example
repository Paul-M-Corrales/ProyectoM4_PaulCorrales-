# Plantilla sin valores reales. Copiar a .env.local (ignorado por Git) y completar con la
# configuración web de Firebase (Consola > Configuración del proyecto > Tus apps > On-going Web).
# Son identificadores públicos de la app web; nunca incluir claves de Firebase Admin ni cuentas de servicio.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Solo servidor (Vercel Functions / .env.local en desarrollo). NUNCA con prefijo VITE_ ---
# AWS SES (identidad verificada; usuario IAM con permiso ses:SendEmail limitado a esa identidad)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
# Firebase Admin (cuenta de servicio): solo los tres campos necesarios, no el JSON completo
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Opcional: orígenes extra autorizados para llamar al endpoint, separados por coma
APP_ALLOWED_ORIGINS=
